# Copy to .env and fill in. Never commit .env.
ENV=development
APP_URL=http://localhost:5173
TIMEZONE=America/New_York
# Local: SQLite file. Hosted: your Neon connection string (postgresql://...)
DATABASE_URL=sqlite:///./dev.db

# python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Keep this safe: losing it means reconnecting every bank.
ENCRYPTION_KEY=
# Comma-separated emails allowed to sign in
ALLOWED_EMAILS=you@example.com
# Any long random string; also add it as the CRON_SECRET GitHub Actions secret
CRON_SECRET=
# Lets you sign in locally without OAuth set up (ignored when ENV=production)
DEV_LOGIN_EMAIL=you@example.com

# From https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Set only after registering it in Plaid Dashboard > Developers > API > Allowed redirect URIs
PLAID_REDIRECT_URI=
# Defaults to APP_URL/api/v1/plaid/webhook when APP_URL is public
PLAID_WEBHOOK_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
